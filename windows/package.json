{
  "name": "mangamanager-windows",
  "version": "1.0.1",
  "private": true,
  "description": "Windows launcher for MangaManager",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron .",
    "build:frontend": "npm --prefix ../frontend install && npm --prefix ../frontend run build",
    "prepare:runtime": "powershell -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "verify:runtime": "node scripts/verify-runtime.js",
    "pack": "electron-builder --dir",
    "dist:win:zip": "npm run build:frontend && npm run verify:runtime && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "^35.2.0",
    "electron-builder": "^26.0.20"
  },
  "build": {
    "appId": "fun.kangen.mangamanager",
    "productName": "MangaManager",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "app/**/*",
          "alembic/**/*",
          "alembic.ini",
          "pyproject.toml",
          "uv.lock"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../shared",
        "to": "shared"
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "zip"
      ]
    }
  }
}
